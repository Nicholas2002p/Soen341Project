{
  "name": "careerconnect",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/server && npm run build --workspace=apps/client",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.47.0",
    "react-router": "^8.4.0",
    "sass": "^1.105.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true
  }
}
